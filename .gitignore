# Build output
*.o
*.obj
*.P
*.i
*.swp
build/
bin/
obj*/
Debug/
Release/

# Visual Studio (ignore only user-specific and temp files)
.vs/
*.suo
*.user
*.ilk
*.pdb
*.lib
*.exp
UpgradeLog*.htm

# Backup folders
Backup*/

# Generated Syzygy tablebase files (never commit these - they are huge)
*.rtbw
*.rtbz

# Partial/incomplete tablebase files (legacy rule, kept for safety)
*.rtbw.*
*.rtbz.*

# Python cache
__pycache__/
*.pyc
*.pyo

# Device files
nul

# Log directories (automation logs, generation logs, etc.)
logs/
log/
src/logs/
src/log/

# Log files (build logs, iteration logs, debug logs, feedback logs, etc.)
*.log
*.log.*

# Syzygy tablebase output directories (generated .rtbw/.rtbz files - very large)
Syzygy/
src/Syzygy/

# Local clone of the Stockfish engine (separate git repo, used for probing tests)
StockfishSrc/

# Helper scripts and auto-generated files (optional)
FromPowerShell.ps1
claude-loop.ps1
