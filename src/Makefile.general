# =============================================================================
# Makefile.general - Common build rules for tb-1 tablebase generator
# =============================================================================
# Features:
# - Automatic dependency generation
# - Parallel build support
# - Incremental compilation
# - Clean build artifacts
# =============================================================================

SHELL := /bin/sh

# Avoid multiple .SUFFIXES declarations
.SUFFIXES:
.SUFFIXES: .c .o .P

# Object file locations
vpath %.o $(OBJDIR)
vpath %.P $(DEPDIR)

# Compiler flags
CFLAGS ?= -O3 -march=native -pipe -Wall -std=c11
LDFLAGS ?=

# Feature flags
FLAGS ?=

# Default directories
DEPDIR ?= .deps
OBJDIR ?= objs

# =============================================================================
# Object file lists per target
# =============================================================================

TBOBJS := tbgen.o tbgenp.o permute.o compress.o huffman.o threads.o lz4.o tbver.o tbverp.o decompress.o checksum.o city-c.o tbcheck.o util.o virtual_table.o vt_drive_utils.o
GENTBOBJS := tbgen.o permute.o compress.o huffman.o threads.o lz4.o checksum.o city-c.o util.o virtual_table.o vt_drive_utils.o
GENTBPOBJS := tbgenp.o permute.o compress.o huffman.o threads.o lz4.o checksum.o city-c.o util.o virtual_table.o vt_drive_utils.o
VERTBOBJS := tbver.o decompress.o threads.o checksum.o city-c.o util.o
VERTBPOBJS := tbverp.o decompress.o threads.o checksum.o city-c.o util.o
TBCHECKOBJS := tbcheck.o threads.o checksum.o city-c.o lz4.o util.o

# Source files for dependency generation
CFILES := tbgen.c tbgenp.c tbver.c tbverp.c permute.c compress.c huffman.c threads.c lz4.c decompress.c checksum.c city-c.c tbcheck.c util.c

# Include auto-generated dependencies
-include $(CFILES:%.c=$(DEPDIR)/%.P)
-include $(TBOBJS:%.o=$(DEPDIR)/%.P)

# =============================================================================
# Main build targets
# =============================================================================

# Default target
all: $(NAME)

# Build target executable
$(NAME): $(OBJS)
	@echo "Linking $@..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJS:%=$(OBJDIR)/%) $(LDFLAGS)

# Compile source to object file
$(OBJDIR)/%.o: %.c
	@echo "Compiling $<..."
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< $(FLAGS) -o $@

# Generate dependency files
$(DEPDIR)/%.P: %.c
	@echo "Generating dependencies for $<..."
	@mkdir -p $(DEPDIR)
	@$(CC) -M $(FLAGS) $< | sed "s/$*.o/$*.o $*.P/" >$@

# =============================================================================
# Alias targets (base names)
# =============================================================================

# Extract base name from full path
GENTB_BASE := $(notdir $(GENTBNAME:.exe=))
GENTBP_BASE := $(notdir $(GENTBPNAME:.exe=))
VERTB_BASE := $(notdir $(VERTBNAME:.exe=))
VERTBP_BASE := $(notdir $(VERTBPNAME:.exe=))
TB_CHECK_BASE := $(notdir $(TB_CHECK_NAME:.exe=))

# =============================================================================
# Variant build targets
# =============================================================================

# Generic tablebase generator
$(GENTBNAME): $(GENTBOBJS)
	@echo "Linking $@..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJDIR)/tbgen.o $(OBJDIR)/permute.o $(OBJDIR)/compress.o $(OBJDIR)/huffman.o $(OBJDIR)/threads.o $(OBJDIR)/lz4.o $(OBJDIR)/checksum.o $(OBJDIR)/city-c.o $(OBJDIR)/util.o $(LDFLAGS)

# Generic pawnful tablebase generator
$(GENTBPNAME): $(GENTBPOBJS)
	@echo "Linking $@..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJDIR)/tbgenp.o $(OBJDIR)/permute.o $(OBJDIR)/compress.o $(OBJDIR)/huffman.o $(OBJDIR)/threads.o $(OBJDIR)/lz4.o $(OBJDIR)/checksum.o $(OBJDIR)/city-c.o $(OBJDIR)/util.o $(LDFLAGS)

# Tablebase verifier
$(VERTBNAME): $(VERTBOBJS)
	@echo "Linking $@..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJDIR)/tbver.o $(OBJDIR)/decompress.o $(OBJDIR)/threads.o $(OBJDIR)/checksum.o $(OBJDIR)/city-c.o $(OBJDIR)/util.o $(LDFLAGS)

# Pawnful tablebase verifier
$(VERTBPNAME): $(VERTBPOBJS)
	@echo "Linking $@..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJDIR)/tbverp.o $(OBJDIR)/decompress.o $(OBJDIR)/threads.o $(OBJDIR)/checksum.o $(OBJDIR)/city-c.o $(OBJDIR)/util.o $(LDFLAGS)

# Integrity checker
tbcheck: $(TBCHECKOBJS)
	@echo "Linking $@..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJDIR)/tbcheck.o $(OBJDIR)/threads.o $(OBJDIR)/checksum.o $(OBJDIR)/city-c.o $(OBJDIR)/lz4.o $(OBJDIR)/util.o $(LDFLAGS)

# =============================================================================
# Clean targets
# =============================================================================

clean:
	@echo "Cleaning build artifacts..."
	@rm -rf $(OBJDIR) $(DEPDIR)
	@rm -f *.o
	@echo "Clean complete."

.PHONY: all clean